generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
}

model Books {
    id               Int      @id @default(autoincrement())
    title            String   @db.Text
    publication_date DateTime @db.Date
    price            Decimal  @db.Decimal(10, 2)

    authorId Int
    authors  Authors       @relation(fields: [authorId], references: [id])
    genres   Book_Genres[]
    loans    Loans[]
}

model Authors {
    id    Int     @id @default(autoincrement())
    name  String  @db.Text
    books Books[]
}

model Genres {
    id         Int           @id @default(autoincrement())
    name       String        @db.Text
    bookGenres Book_Genres[]
}

model Book_Genres {
    bookId Int
    books  Books @relation(fields: [bookId], references: [id])

    genreId Int
    genres  Genres @relation(fields: [genreId], references: [id])

    @@unique([bookId, genreId])
}

enum Loans_Status {
    ACTIVE
    RETURNED
    OVERDUE
}

model Loans {
    id          Int          @id @default(autoincrement())
    start_date  DateTime
    due_date    DateTime
    return_date DateTime?
    status      Loans_Status @default(ACTIVE)

    booksId Int
    books   Books @relation(fields: [booksId], references: [id])

    membersId Int
    members   Members @relation(fields: [membersId], references: [id])
}

model Members {
    id    Int     @id @default(autoincrement())
    name  String
    email String  @unique
    loans Loans[]
}
